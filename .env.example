# Basic configuration
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB_NAME
SESSION_SECRET=replace-with-a-long-random-secret
NODE_ENV=development
PORT=5000
EXPO_PUBLIC_USE_HTTP=true
EXPO_PUBLIC_DOMAIN=localhost:5000
EXPO_PUBLIC_ORIGIN=http://localhost:8081

# One-time bootstrap secret. Only required when the local admin has no password.
# Minimum 8 characters and at least three of: lowercase, uppercase, number, symbol.
ADMIN_BOOTSTRAP_PASSWORD=replace-with-a-strong-one-time-password

# Required in production. Node serves TLS directly from these PEM files.
HTTPS_CERT_PATH=/etc/okr/tls/fullchain.pem
HTTPS_KEY_PATH=/etc/okr/tls/privkey.pem
HTTPS_PORT=5000
HTTP_PORT=5001
PUBLIC_HTTPS_ORIGIN=https://okr.example.com:5000

# DingTalk login
DINGTALK_APP_KEY=replace-with-dingtalk-app-key
DINGTALK_APP_SECRET=replace-with-dingtalk-app-secret
DINGTALK_CORP_ID=replace-with-dingtalk-corp-id

# AI analysis API
AI_INTEGRATIONS_OPENAI_API_KEY=replace-with-api-key
AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.example.com/v1
AI_MODEL_OKR_ANALYSIS=DeepSeek-V3.2
AI_MODEL_CHAT=gpt-5.1
AI_MODEL_IMAGE=gpt-image-1
AI_MODEL_AUDIO=gpt-audio
AI_MODEL_TRANSCRIBE=gpt-4o-mini-transcribe
